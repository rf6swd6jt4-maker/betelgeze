'use client'
import {useEffect,useState} from 'react'
export default function Host(){const [active,setActive]=useState(true),[covered,setCovered]=useState(false);useEffect(()=>{document.body.dataset.workspaceActiveTabId=active?'one':'other';document.body.dataset.workspaceTabsHosted='true';const frame=document.querySelector('iframe')?.contentWindow;frame?.dispatchEvent(new Event('betelgeze:workspace-tab-visibility'))},[active]);return <><button id="switch" onClick={()=>setActive(!active)}>Switch</button><button id="cover" onClick={()=>setCovered(true)}>Cover</button><iframe name="betelgeze-tab:one" style={{display:active?'block':'none',border:0,width:'100%',height:'calc(100vh - 40px)'}} src="/reader?__betelgeze_tab=one"/>{covered&&<div style={{position:'fixed',inset:0,background:'#888',zIndex:100}}><button id="uncover" onClick={()=>setCovered(false)}>Close viewer</button></div>}</>}
