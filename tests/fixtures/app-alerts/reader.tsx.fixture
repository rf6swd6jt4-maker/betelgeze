'use client'
import {useState,useRef,useEffect} from 'react'
import {useConversationRead} from '@/components/communications/useConversationRead'
import {useWorkspaceTabActive} from '@/components/workspace/useWorkspaceTabActive'
import {useConversationLayout} from '@/components/communications/useConversationLayout'
import {subscribeChatReads,type ChatReadUpdate} from '@/lib/communications/read-state'
import {CommunicationsActivityTracker} from '@/components/communications/CommunicationsActivityTracker'
import {nativeConversationUnreadCount} from '@/lib/communications/unread'
const id=(n:number)=>`00000000-0000-4000-8000-${String(n).padStart(12,'0')}`
export default function Reader(){
 const [count,setCount]=useState(20),[atLatest,setAtLatest]=useState(true),[jump,setJump]=useState(false),[cursor,setCursor]=useState<ChatReadUpdate>();
 const pane=useRef<HTMLDivElement>(null),follow=useRef(true),tabActive=useWorkspaceTabActive()
 const messages=Array.from({length:count},(_,i)=>({id:id(i+1),createdAt:new Date(Date.UTC(2026,8,17,10,0,i+1)).toISOString(),senderUserId:'other'}))
 useEffect(()=>subscribeChatReads('w','u',setCursor),[])
 useConversationLayout(pane,follow,'chat',tabActive,setAtLatest,setJump)
 const reading=useConversationRead({workspaceId:'w',workspaceSlug:'fixture',userId:'u',kind:'native',conversationId:'chat',latest:messages.at(-1),cursor,active:true,atLatest,pane})
 useEffect(()=>{Object.assign(window,{addMessage:()=>setCount(n=>n+1)})},[])
 return <><div style={{height:40}}><button id="add" onClick={()=>setCount(n=>n+1)}>Incoming</button><span id="unread">{nativeConversationUnreadCount({messages},cursor,'u')}</span><span id="error">{reading.error}</span><span id="jump">{String(jump)}</span></div><div ref={pane} data-message-pane style={{height:'calc(100vh - 50px)',overflowY:'auto'}}><div>{messages.map(m=><div key={m.id} data-message-interaction={m.id} data-message-scroll-anchor={m.id} style={{height:65,borderBottom:'1px solid',boxSizing:'border-box'}}>Message {m.id.slice(-3)}</div>)}</div></div><CommunicationsActivityTracker workspaceId="w" conversationId="chat" conversationKind="native" connectionState="live" isReading={reading.isReading}/></>
}
